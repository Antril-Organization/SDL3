# Signing keys: private, never published (package/hive.key signs the Hive package).
*.key
*.pem

# Build output: programs and packed packages (larva build, larva hive pack).
bin/

# The local Hive registry the package is published to for testing, and Hive caches.
registry/
.hive/

# The compiled binding: regenerated by `larva bind --profile SDLBindingProfile.ant` (bindings/ keeps its readable source).
SDL.Bindings.dll

# Editors and the system.
.vs/
.vscode/
*.user
Thumbs.db
Desktop.ini
.DS_Store
