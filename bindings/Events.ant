			FlushEvents(u32 minType, u32 maxType);

			[Import("SDL3.dll", "SDL_PollEvent")]
			PollEvent(Event* event) : bool;

			[Import("SDL3.dll", "SDL_WaitEvent")]
			WaitEvent(Event* event) : bool;

			[Import("SDL3.dll", "SDL_WaitEventTimeout")]
			WaitEventTimeout(Event* event, i32 timeoutMS) : bool;

			[Import("SDL3.dll", "SDL_PushEvent")]
			PushEvent(Event* event) : bool;

			[Import("SDL3.dll", "SDL_SetEventFilter")]
			SetEventFilter(func*<void*, Event*> : bool filter, void* userdata);

			[Import("SDL3.dll", "SDL_GetEventFilter")]
			GetEventFilter(void* filter, void** userdata) : bool;

			[Import("SDL3.dll", "SDL_AddEventWatch")]
			AddEventWatch(func*<void*, Event*> : bool filter, void* userdata) : bool;

			[Import("SDL3.dll", "SDL_RemoveEventWatch")]
			RemoveEventWatch(func*<void*, Event*> : bool filter, void* userdata);

			[Import("SDL3.dll", "SDL_FilterEvents")]
			FilterEvents(func*<void*, Event*> : bool filter, void* userdata);

			[Import("SDL3.dll", "SDL_SetEventEnabled")]
			SetEventEnabled(u32 type, bool enabled);

			[Import("SDL3.dll", "SDL_EventEnabled")]
			EventEnabled(u32 type) : bool;

			[Import("SDL3.dll", "SDL_RegisterEvents")]
			RegisterEvents(i32 numevents) : u32;

			[Import("SDL3.dll", "SDL_GetWindowFromEvent")]
			GetWindowFromEvent(Event* event) : void*;

			[Import("SDL3.dll", "SDL_GetEventDescription")]
			GetEventDescription(Event* event, str? buf, i32 buflen) : i32;
	}
}
